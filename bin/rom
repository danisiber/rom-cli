def _wiki_raw(title, depth=0):
    st, _, body = request(f"https://en.wikipedia.org/w/index.php?title={title}&action=raw",
                          retries=2, timeout=40)
    if st != 200 or depth > 2:
        return ""
    text = body.decode("utf-8", "replace")
    m = re.match(r"\s*#REDIRECT\s*\[\[([^\]]+)\]\]", text, re.I)
    if m:
        return _wiki_raw(urllib.parse.quote(m.group(1).replace(" ", "_")), depth + 1)
    return text


_WIKI_ATTR = re.compile(r'^[|!]\s*(?:[A-Za-z_:][\w:.-]*\s*=\s*'
                        r'(?:"[^"]*"|\'[^\']*\'|[^\s|]+)\s*)*\|?\s*')
_WIKI_LINK = re.compile(r"\[\[([^\]\|#]+)(?:\|([^\]]+))?\]\]")
_WIKI_SALES = (re.compile(r"\{\{nts\|([\d.,]+)\}\}"),
               re.compile(r"\{\{val\|([\d.,]+)"),
               re.compile(r"\b(\d{1,3}(?:,\d{3}){1,}|\d{6,})\b"))


def _wiki_tables(text):
    out, cur, depth = [], None, 0
    for line in text.splitlines():
        s = line.strip()
        if s.startswith("{|"):
            if depth == 0:
                cur = []
            depth += 1
        if cur is not None:
            cur.append(line)
        if s.startswith("|}"):
            depth = max(0, depth - 1)
            if depth == 0 and cur is not None:
                out.append(cur)
                cur = None
    return out


def _wiki_rows(lines):
    rows, cur = [], None

    def flush(cells):
        if not cells:
            return
        title, sales = None, 0.0
        for cell in cells:
            body = _WIKI_ATTR.sub("", cell.strip(), count=1)
            if title is None:
                m = _WIKI_LINK.search(body)
                if m:
                    title = re.sub(r"''", "", m.group(2) or m.group(1))
                    title = re.sub(r"&nbsp;|&#160;|\u00a0", " ", title)
                    title = re.sub(r"\s+", " ", title).strip()
            if sales == 0.0:
                for pat in _WIKI_SALES:
                    mm = pat.search(body)
                    if mm:
                        try:
                            sales = float(mm.group(1).replace(",", ""))
                        except ValueError:
                            sales = 0.0
                        if sales:
                            break
        if title and sales > 0:
            rows.append(title)

    for line in lines:
        s = line.strip()
        if s == "|-":
            flush(cur)
            cur = []
        elif cur is not None and s.startswith(("|", "!")):
            cur.append(line)
    flush(cur)
    return rows


def _parse_wiki(text):
    best = []
    for tbl in _wiki_tables(text):
        rows = _wiki_rows(tbl)
        if len(rows) > len(best):
            best = rows
    return best


def load_popular(force=False):
    global POPULAR, POPULAR_NORM
    if POPULAR is not None and not force:
        return POPULAR
    if not force and os.path.exists(POPULAR_FILE):
        try:
            d = json.load(open(POPULAR_FILE))
            if time.time() - d.get("fetched_at", 0) < POPULAR_TTL and d.get("data"):
                POPULAR = d["data"]
                POPULAR_NORM = None
                return POPULAR
        except Exception:
            pass
    data = {}
    for pk, page in WIKI_LISTS.items():
        try:
            titles = _parse_wiki(_wiki_raw(page))
        except Exception:
            titles = []
        seen, ranked = set(), []
        for t in titles:
            nt = norm(t)
            if nt and nt not in seen:
                seen.add(nt)
                ranked.append(t)
        if ranked:
            data[pk] = ranked
    try:
        os.makedirs(CACHE_DIR, exist_ok=True)
        tmp = POPULAR_FILE + ".tmp"
        with open(tmp, "w") as f:
            json.dump({"fetched_at": time.time(), "data": data}, f)
        os.replace(tmp, POPULAR_FILE)
    except Exception:
        pass
    POPULAR = data
    POPULAR_NORM = None
    return data


def _pop_norm(pk):
    global POPULAR_NORM
    if POPULAR_NORM is None:
        POPULAR_NORM = {}
    if pk not in POPULAR_NORM:
        POPULAR_NORM[pk] = {norm(t): i for i, t in enumerate((POPULAR or {}).get(pk, []))}
    return POPULAR_NORM[pk]


def pop_rank(pk, title):
    nt = norm(title)
    if not nt:
        return None
    m = _pop_norm(pk)
    if not m:
        return None
    if nt in m:
        return m[nt]
    best = None
    for wt, i in m.items():
        if nt.startswith(wt + " "):
            if best is None or i < best:
                best = i
    return best


def annotate_popular(results):
    load_popular()
    for r in results:
        pk = r.meta.get("pk") or LABEL_KEY.get(r.platform)
        if not pk:
            continue
        rk = pop_rank(pk, r.title)
        if rk is not None:
            r.meta["pop"] = rk
    return results


KIND_ORDER = {"Base": 0, "": 1, "Port": 1, "Update": 2, "DLC": 3}


def browse_items(platform_key):
    if platform_key == "switchports":
        items = DLA.all_items("switch", ports_only=True)
        try:
            items += SOURCES["archive.org"].port_results()
        except Exception:
            pass
        seen, uniq = set(), []
        for r in items:
            k = norm(r.title)
            if k and k not in seen:
                seen.add(k)
                uniq.append(r)
        uniq.sort(key=lambda r: norm(r.title))
        return uniq
    src_name, arg = PLATFORMS[platform_key]
    src = SOURCES[src_name]
    pk = platform_key
    if hasattr(src, "all_items"):
        items = src.all_items(arg)
    else:
        load_popular()
        titles = (POPULAR or {}).get(pk) or []
        if not titles:
            raise RuntimeError(f"{PLATFORM_LABELS.get(pk, pk)}: no listing — use the search")
        items = [Result("dlpsgame", t, PLATFORM_LABELS.get(pk, pk), "",
                        meta={"ext": "pkg", "pk": pk, "pop": i, "search_title": t})
                 for i, t in enumerate(titles)]
        return items
    load_popular()
    if (POPULAR or {}).get(pk):
        def key(r):
            kind = KIND_ORDER.get(r.kind, 1)
            size = -int(r.meta.get("bytes") or 0)
            rk = pop_rank(pk, r.title)
            if rk is not None:
                r.meta["pop"] = rk
                return (0, rk, kind, size, norm(r.title))
            return (1, 0, kind, size, norm(r.title))
        items.sort(key=key)
    return items


def run_tui(platform_key="", query="", outdir=None, force=False):
    from textual.app import App, ComposeResult
    from textual.widgets import Input, DataTable, Footer, Header, Static
    from textual.widgets.option_list import Option
    from textual.widgets import OptionList
    from textual.screen import ModalScreen
    from textual.containers import Vertical
    from textual.binding import Binding

    outdir = outdir or OUT_DIR

    class OptionsScreen(ModalScreen):
        CSS = """
        OptionsScreen { align: center middle; background: $background 60%; }
        #opts { width: 64; height: auto; max-height: 80%; background: $surface;
                border: round $primary; padding: 1 2; }
        #opts-title { text-style: bold; margin-bottom: 1; }
        #opts-list { height: auto; }
        #opts-hint { text-style: dim italic; margin-top: 1; }
        """
        BINDINGS = [Binding("escape", "cancel", "Close"),
                    Binding("ctrl+b", "cancel", "Close", show=False),
                    Binding("q", "cancel", "Close", show=False)]

        def __init__(self, options):
            super().__init__()
            self.options = options

        def compose(self) -> ComposeResult:
            with Vertical(id="opts"):
                yield Static("Options", id="opts-title")
                yield OptionList(*[Option(o[0], id=o[1]) for o in self.options], id="opts-list")
                yield Static("↑↓ move · Enter select · esc close", id="opts-hint")

        def on_option_list_option_selected(self, event):
            self.dismiss(event.option_id)

        def action_cancel(self):
            self.dismiss(None)

    class PlataformasScreen(OptionsScreen):
        def compose(self) -> ComposeResult:
            with Vertical(id="opts"):
                yield Static("Platform", id="opts-title")
                opts = [("todas", "all")] + [(PLATFORM_LABELS[k], k) for k in sorted(PLATFORM_LABELS)]
                yield OptionList(*[Option(t, id=i) for t, i in opts], id="opts-list")
                yield Static("↑↓ move · Enter choose · esc close", id="opts-hint")

    class RomApp(App):
        TITLE = "rom"
        CSS = """
        Input { dock: top; }
        #status { height: 3; background: $surface; padding: 0 1; dock: bottom; }
        Footer { dock: bottom; }
        DataTable { height: 1fr; }
        """
        BINDINGS = [
            ("q", "quit", "Quit"),
            ("d", "download", "Download"),
            ("c", "copy_url", "Copy URL"),
            ("space", "toggle", "Select"),
            ("p", "platform", "Platform"),
            ("n", "next_page", "Page+"),
            ("b", "prev_page", "Page-"),
            ("ctrl+b", "palette", "Options"),
            ("ctrl+a", "select_all", "Select all"),
            ("ctrl+n", "select_none", "Clear"),
        ]

        def __init__(self, platform_key, query, outdir, force):
            super().__init__()
            self.results = []
            self.selected = set()
            self.last_query = ""
            self.pk = platform_key or ""
            self.initial_query = query or ""
            self.outdir = outdir
            self.force = force
            self.browse_items = None
            self.page = 0

        def compose(self) -> ComposeResult:
            yield Header(show_clock=True)
            yield Input(placeholder="Type the game name and press Enter…  (p switches platform)")
            yield DataTable(cursor_type="row")
            yield Footer()
            yield Static("", id="status")

        def on_mount(self):
            table = self.query_one(DataTable)
            table.add_columns(" ", "Title", "Platform", "Type", "Size", "Source")
            self.col_keys = list(table.columns.keys())
            self._busy = None
            self._frame = 0
            self.set_interval(0.1, self._tick)
            self._set_status(self._hint())
            self.query_one(Input).focus()
            if self.initial_query:
                self.query_one(Input).value = self.initial_query
                self._start_search(self.initial_query)
            elif self.pk:
                self._start_browse(self.pk)
            else:
                self.call_after_refresh(self._open_platforms)

        def _tick(self):
            if not self._busy:
                return
            frames = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
            self._frame += 1
            self.query_one(Static).update(f"{frames[self._frame % len(frames)]} {self._busy}")

        def _hint(self):
            plat = PLATFORM_LABELS.get(self.pk, "todas") if self.pk else "todas"
            return (f"platform: {plat} · space mark · d download · p browse/switch · "
                    f"n/b page · ctrl+b options · q quit")

        def _set_status(self, msg):
            self._busy = None
            self.query_one(Static).update(msg)

        def _busy_msg(self, msg):
            self._busy = msg

        def on_input_submitted(self, event):
            q = event.value.strip()
            if q:
                self._start_search(q)

        def _start_search(self, q):
            self.last_query = q
            self.selected.clear()
            self._busy = f"searching for '{q}'…"
            self.query_one(Static).update(f"⠋ searching for '{q}'…")
            threading.Thread(target=self._search_bg, args=(q,), daemon=True).start()

        def _search_bg(self, q):
            try:
                results = search(
                    q, self.pk or None,
                    on_progress=lambda d, t: self._busy_msg(f"building the catalog index… {d}/{t}"),
                    force=self.force)
                self.force = False
                self.call_from_thread(self._show, rank(results, q))
            except Exception as e:
                self.call_from_thread(self._set_status, f"✖ search error: {e}")

        def _show(self, results):
            self.browse_items = None
            table = self.query_one(DataTable)
            table.clear()
            self.results = results
            for i, r in enumerate(results[:200]):
                table.add_row(*self._cells(i, r), key=str(i))
            table.focus()
            msg = f"{len(results)} results" if results else "nothing found"
            self._set_status(f"{msg} — {self._hint()}")

        def _start_browse(self, pk):
            self.last_query = ""
            self.selected.clear()
            self._busy = f"opening {PLATFORM_LABELS.get(pk, pk)}…"
            self.query_one(Static).update(f"⠋ {self._busy}")
            threading.Thread(target=self._browse_bg, args=(pk,), daemon=True).start()

        def _browse_bg(self, pk):
            try:
                self.call_from_thread(self._set_browse, browse_items(pk))
            except Exception as e:
                self.call_from_thread(self._set_status, f"✖ {e}")

        def _set_browse(self, items):
            self.browse_items = items
            self.page = 0
            self._render_page()

        def _render_page(self):
            items = self.browse_items or []
            size = 300
            pages = max(1, (len(items) + size - 1) // size)
            self.page = max(0, min(self.page, pages - 1))
            chunk = items[self.page * size:(self.page + 1) * size]
            self.results = chunk
            self.selected.clear()
            table = self.query_one(DataTable)
            table.clear()
            for i, r in enumerate(chunk):
                table.add_row(*self._cells(i, r), key=str(i))
            table.focus()
            plat = PLATFORM_LABELS.get(self.pk, self.pk or "todas")
            self._set_status(f"{plat} · {len(items)} items · page {self.page + 1}/{pages}"
                             " — n/b page · space mark · d download · q quit")

        def action_next_page(self):
            if self.browse_items is None:
                return
            self.page += 1
            self._render_page()

        def action_prev_page(self):
            if self.browse_items is None:
                return
            self.page = max(0, self.page - 1)
            self._render_page()

        def _cells(self, i, r):
            from rich.text import Text as RT
            sel = i in self.selected
            mark = RT("  ✔  ", style="black on green") if sel else ""
            style = "black on dark_green" if sel else None
            star = "★ " if r.meta.get("pop") is not None else ""
            vals = [mark, star + r.title[:60], r.platform, r.kind or "-",
                    r.size or "?", r.source]
            out = [mark]
            for v in vals[1:]:
                out.append(RT(str(v), style=style) if style else str(v))
            return out

        def _redraw(self):
            table = self.query_one(DataTable)
            for i, r in enumerate(self.results[:200]):
                for ck, val in zip(self.col_keys, self._cells(i, r)):
                    table.update_cell(str(i), ck, val)

        def _status_sel(self):
            n = len(self.selected)
            msg = f"{len(self.results)} results"
            if n:
                msg += f" · ✔ {n} selected"
            self._set_status(msg + " — " + self._hint())

        def action_toggle(self):
            table = self.query_one(DataTable)
            if table.cursor_row is None or not self.results:
                return
            i = table.cursor_row
            self.selected.symmetric_difference_update({i})
            self._redraw()
            self._status_sel()

        def action_select_all(self):
            self.selected = set(range(len(self.results[:200])))
            self._redraw()
            self._status_sel()

        def action_select_none(self):
            self.selected.clear()
            self._redraw()
            self._status_sel()

        def action_platform(self):
            self._open_platforms()

        def _open_platforms(self):
            def chosen(val):
                if val is None:
                    return
                self.pk = "" if val == "all" else val
                if self.last_query:
                    self._start_search(self.last_query)
                elif self.pk:
                    self._start_browse(self.pk)
                else:
                    self._set_status("platform: all — type a name and press Enter")
            self.push_screen(PlataformasScreen([]), callback=chosen)

        def action_palette(self):
            self.push_screen(
                OptionsScreen([
                    ("Download selected", "sel"),
                    ("Download current", "cur"),
                    ("Copy current URL", "url"),
                    ("Browse this platform", "browse"),
                    ("Switch platform", "plat"),
                    ("Select all", "all"),
                    ("Clear selection", "none"),
                ]),
                callback=self._palette,
            )

        def _palette(self, choice):
            if choice is None:
                return
            if choice == "sel":
                self._batch([self.results[i] for i in sorted(self.selected)])
            elif choice == "cur":
                self.action_download()
            elif choice == "url":
                self.action_copy_url()
            elif choice == "browse":
                if self.pk:
                    self._start_browse(self.pk)
                else:
                    self.action_platform()
            elif choice == "all":
                self.action_select_all()
            elif choice == "none":
                self.action_select_none()
            elif choice == "plat":
                self.action_platform()

        def on_data_table_row_selected(self, event):
            table = self.query_one(DataTable)
            if table.cursor_row is not None and self.results:
                self.selected.add(table.cursor_row)
                self._redraw()
                self.action_palette()

        def action_download(self):
            table = self.query_one(DataTable)
            if table.cursor_row is None or not self.results:
                return
            self._batch([self.results[table.cursor_row]])

        def action_copy_url(self):
            table = self.query_one(DataTable)
            if table.cursor_row is None or not self.results:
                return
            r = self.results[table.cursor_row]
            self._set_status(f"getting link: {r.title[:45]}…")
            threading.Thread(target=self._copy_url_bg, args=(r,), daemon=True).start()

        def _copy_url_bg(self, r):
            try:
                _, url, _ = resolve_url(r)
            except Exception as e:
                self.call_from_thread(self._set_status, f"✖ {r.title[:40]}: {e}")
                return
            self.call_from_thread(self._copy, url)

        def _copy(self, url):
            if not copy_clipboard(url):
                self.copy_to_clipboard(url)  # OSC 52 fallback, needs terminal support
            self._set_status(f"✔ copied: {url}")

        def _batch(self, rows):
            if not rows:
                self._set_status("nothing selected")
                return
            self._set_status(f"downloading 0/{len(rows)}…")
            threading.Thread(target=self._batch_bg, args=(rows,), daemon=True).start()

        def _batch_bg(self, rows):
            ok, fail, total = 0, 0, len(rows)
            for n, r in enumerate(rows, 1):
                label = f"{n}/{total} {r.title[:38]}"

                def prog(read, tot, msg, label=label):
                    self.call_from_thread(self._set_status, f"downloading {label} · {msg}")
                try:
                    path = download(r, self.outdir, on_progress=prog)
                    ok += 1
                    self.call_from_thread(self._set_status, f"✔ {path}")
                except Exception as e:
                    fail += 1
                    self.call_from_thread(self._set_status, f"✖ {r.title[:40]}: {e}")
            self.call_from_thread(self._set_status,
                                  f"✔ {ok}/{total} downloaded to {self.outdir}"
                                  + (f" · {fail} failed" if fail else ""))

    RomApp(platform_key, query, outdir, force).run()


def main():
    ap = argparse.ArgumentParser(description="Search and download ROMs/ISOs/Switch games.")
    ap.add_argument("query", nargs="*")
    ap.add_argument("-p", "--platform", help="switch, snes, gba, ps2, nds, wii… (see -l)")
    ap.add_argument("-l", "--platforms", action="store_true", help="list platforms")
    ap.add_argument("-y", "--yes", action="store_true", help="download the best match without asking")
    ap.add_argument("--list", action="store_true", help="list results only")
    ap.add_argument("--print-url", action="store_true", help="print the direct link and exit")
    ap.add_argument("--refresh", action="store_true", help="rebuild the catalog index")
    ap.add_argument("--index", action="store_true", help="download/print the index and exit")
    ap.add_argument("-n", "--number", type=int, default=15, help="how many results to show")
    ap.add_argument("-o", "--out", default=OUT_DIR, help="destination folder")
    args = ap.parse_args()

    if args.platforms:
        write("  platforms: " + ", ".join(sorted(PLATFORMS)))
        return 0

    key = (args.platform or "").lower().strip()
    if key and key not in PLATFORMS:
        ap.error(f"unknown platform: {key}\n  use: {', '.join(sorted(PLATFORMS))}")

    if args.index:
        write("  building index…")
        idx = DLA.load_index(force=args.refresh,
                             on_progress=lambda d, t: status(f"   {d}/{t} pages"))
        clear_status()
        with_rom = sum(1 for e in idx if e["ext"] in ("nsp", "xci", "nsz"))
        write(f"  {len(idx)} files in the index ({with_rom} for Switch)")
        write(f"  cache: {INDEX_FILE}")
        pop = load_popular(force=args.refresh)
        top = ", ".join(f"{k}({len(v)})" for k, v in sorted(pop.items()) if v)
        write(f"  best sellers (Wikipedia): {top}")
        return 0

    if not args.query:
        if args.list:
            if not key:
                write("  use -p <platform> (e.g. rom -p switch --list)  ·  or rom -l")
                return 1
            try:
                items = browse_items(key)
            except Exception as e:
                write(f"  ✖ {e}")
                return 1
            show(items, args.number)
            write(f"  {len(items)} items in the {PLATFORM_LABELS.get(key, key)} catalog"
                  " — the TUI (rom) browses everything")
            return 0
        if not sys.stdin.isatty() or not _has_textual():
            write("  type: rom -p switch \"game name\"   (or rom -l)")
            return 0

    query = " ".join(args.query)

    if not query:
        run_tui(key, "", args.out, args.refresh)
        return 0

    status(f"searching for '{query}'…")
    try:
        results = search(query, key or None,
                         on_progress=lambda d, t: status(f"   index {d}/{t} pages"),
                         force=args.refresh)
    except Exception as e:
        clear_status()
        write(f"  ✖ search failed: {e}")
        return 1
    clear_status()

    if not results:
        write("  ✖ nothing found. Try a different name or platform.")
        return 1

    results = rank(results, query)
    outdir = os.path.expanduser(args.out)

    if args.list:
        show(results, args.number)
        return 0

    if args.print_url:
        for r in results[:args.number]:
            write(f"  {r.title} [{r.platform} {r.kind or '-'} {r.size or '?'}]")
            if r.source == "dlpsgame":
                for u in DLP.links(r.page):
                    write(f"  {u}")
            else:
                try:
                    url, name = SOURCES[r.source].resolve(r)
                    write(f"  {url}")
                except Exception as e:
                    write(f"  (error: {e})")
            write()
        return 0

    if args.yes or not sys.stdin.isatty():
        show(results, args.number)
        return run_cli_download(results[:1], outdir)

    picked = select_menu(results, args.number)
    if not picked:
        write("  cancelled.")
        return 0
    return run_cli_download(picked, outdir)


def _has_textual():
    try:
        import textual  # noqa: F401
        return True
    except Exception:
        return False


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        clear_status()
        write("\n  cancelled.")
        sys.exit(130)
